<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GeoVali</RootNamespace>
    <AssemblyName>GeoVali</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>geovali</ToolCommandName>
    <PackageId>GeoVali</PackageId>
    <!-- Release builds get their version from the CI workflow, which derives it
         from the conventional commits since the last tag. This is only what a
         local build stamps, so it is deliberately not a real release number. -->
    <Version>0.0.0-local</Version>
    <Description>Regenerates vali GeoGuessr maps on a schedule and republishes them.</Description>
    <RepositoryUrl>https://github.com/slashP/geo-vali</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
